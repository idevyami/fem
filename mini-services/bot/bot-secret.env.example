# FEMBOY WAR 🎀 — الگوی رازهای دیپلوی (این فایل example است؛ نسخه‌ی واقعی bot-secret.env است و هرگز commit/push نمی‌شود)
# منبع رسمی: متغیرهای محیطی واقعی > bot-secret.env (tracked در سندباکس)

BOT_TOKEN=
# URL عمومی Mini App (پس از Deploy پلتفرم)
MINIAPP_URL=
# مغزِ واحد: PRIMARY همانِ URL عمومی دیپلوی است (ربات و Mini App یک جهان را می‌بینند)
API_BASE=
# موتورِ محلیِ سندباکس — failover خودکار وقتی دیپلوی خواب است
API_FALLBACK=http://localhost:3000
SERVICE_KEY=
HEALTH_PORT=3021
GAME_SECRET=
ADMIN_TELEGRAM_IDS=
